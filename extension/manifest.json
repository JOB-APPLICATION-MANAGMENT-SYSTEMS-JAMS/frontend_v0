{
  "manifest_version": 3,
  "name": "JAMS Autofill",
  "version": "0.2.0",
  "description": "Fill job application forms from your JAMS profile and save postings to JAMS. Never submits for you.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://backend-v0-3aeu-omega.vercel.app/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JAMS Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
