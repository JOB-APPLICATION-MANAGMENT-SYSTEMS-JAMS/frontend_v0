{
  "manifest_version": 3,
  "name": "JAMS Autofill",
  "version": "0.1.0",
  "description": "Fill job application forms from your JAMS profile and save postings to JAMS. Never submits for you.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://backend-v0-3aeu-omega.vercel.app/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JAMS Autofill"
  }
}
